{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteGen",
  "version": "0.37.0",
  "identifier": "com.codexu.NoteGen",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3456",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/article/**/*", "**"]
      }
    },
    "windows": [
      {
        "title": "",
        "label": "main",
        "width": 1360,
        "height": 720,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay"
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": [
      "icons",
      "resources/ocr/*"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "bundleVersion": "0.36.0",
      "developmentTeam": "RGZC4ZTJMU",
      "template": "src-tauri/ios-project.yml"
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": null,
      "entitlements": null,
      "exceptionDomain": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["notegen"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRENURGRUVFREY4M0RGRDkKUldUWjM0UGY3djVkVGQ0aDluR0J6SnBUV2dET0FibXdzVmdTL2hIM21QQ1NCS3R2enllUStSd2oK",
      "endpoints": [
        "https://download.notegen.top/updates/latest.json",
        "https://github.com/codexu/note-gen/releases/latest/download/latest.json"
      ]
    }
  }
}
